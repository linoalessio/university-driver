<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>de.lino.thma</groupId>
    <artifactId>university-core</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>university-core</name>

      <!-- Default properties for the application -->
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <!-- Developer contributors of the application -->
    <developers>

        <developer>
            <id>1</id>
            <name>Lino Alessio Kauschinger</name>
            <email>3017575@stud.th-mannheim.de</email>
            <organization>Technische Hochschule Mannheim</organization>
            <organizationUrl>https://www.hs-mannheim.de</organizationUrl>
            <timezone>Europe/Berlin</timezone>
            <roles>
                <role>Developer</role>
                <role>Architect</role>
            </roles>
        </developer>

    </developers>

    <!-- Repository for central dependencies -->
    <repositories>

        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>

        <repository>
            <id>github</id>
            <name>GitHub LinoAlessio Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/linoalessio/database-driver-v2</url>
        </repository>

    </repositories>

    <!-- Required dependencies to run this application -->
    <dependencies>

        <dependency>
            <groupId>de.lino.database</groupId>
            <artifactId>database-driver-plugin</artifactId>
            <version>1.3.3</version>
        </dependency>

        <!-- PDF generation for entity exports, e.g. SemesterPdfExporter -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <!-- Excel (.xlsx) generation for entity exports, see ExcelExporter -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>

        <!-- JavaFX GUI, see ui.StudentGui; classifier is pinned to this machine's platform (Apple Silicon macOS) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21.0.12</version>
            <classifier>mac-aarch64</classifier>
        </dependency>

    </dependencies>

    <!-- Build settings for compiling JAR and javadoc -->
    <build>

        <plugins>

            <!-- Pins the build to JDK 21 (see ~/.m2/toolchains.xml) regardless of the
                 ambient JAVA_HOME, since Lombok's annotation processor silently no-ops
                 under newer JDKs installed on this machine -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <goals><goal>toolchain</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>21</version>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>

            <!-- Compiler setup -->
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

            <!-- Fat jar with Share function -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>de.lino.thma.Launcher</mainClass>
                                    <manifestEntries>
                                        <!-- sqlite-jdbc loads a native library via System.load(); this silences the JDK's restricted native access warning on `java -jar` without a separate command line flag -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                        <!-- Gson reflectively sets final fields (e.g. Profile.id) when deserializing entities in EntityFactory.syncFromDatabase; silences the matching restricted-mutation warning the same way -->
                                        <Enable-Final-Field-Mutation>ALL-UNNAMED</Enable-Final-Field-Mutation>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <!-- Avoid javadoc errors -->
                    <doclint>none</doclint>
                    <encoding>UTF-8</encoding>
                    <charset>UTF-8</charset>
                </configuration>
            </plugin>

            <!-- Lets `mvn javafx:run` launch ui.StudentGui without hand-assembling a module path -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>de.lino.thma.UniversityGui</mainClass>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>

    </build>

</project>
