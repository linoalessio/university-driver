packaging/.jpackage-input/
packaging/.jpackage-dist/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Claude Code ---
# settings.local.json holds machine-specific permissions/paths; CLAUDE.md and
# settings.json (if present) stay tracked since they're meant to be shared.
.claude/settings.local.json

# --- JSON / personal data ---
# Real academic records (grades, exams, modules) - not sample/seed data, so it
# stays local rather than getting committed. See university-core/README.md for
# how to seed this directory on a new machine.
university-core/config/credentials.json
university-core/config/database/

# --- IntelliJ IDEA ---
.idea/
*.iml
.claude

# --- macOS ---
.DS_Store
